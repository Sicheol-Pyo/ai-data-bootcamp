      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TB_Burden_BI용_데이터' name='federated.06z0fq6197qs0a1baqrbz02dm9xp' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='보기 단위' datatype='string' name='[매개 변수 2154535832719363]' param-domain-type='list' role='measure' type='nominal' value='&quot;전세계&quot;'>
              <calculation class='tableau' formula='&quot;전세계&quot;' />
            </column>
            <column caption='지역 선택' datatype='string' name='[매개 변수 2154535832850436]' param-domain-type='list' role='measure' type='nominal' value='&quot;AFR&quot;'>
              <calculation class='tableau' formula='&quot;AFR&quot;' />
            </column>
            <column caption='국가 선택' datatype='string' name='[매개 변수 2154535833366534]' param-domain-type='list' role='measure' type='nominal' value='&quot;Albania&quot;'>
              <calculation class='tableau' formula='&quot;Albania&quot;' />
            </column>
            <column caption='기준연도' datatype='integer' default-format='*' name='[매개 변수 2154535845343242]' param-domain-type='range' role='measure' type='quantitative' value='1990'>
              <calculation class='tableau' formula='1990' />
              <range granularity='1' max='2013' min='1990' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06z0fq6197qs0a1baqrbz02dm9xp'>
            <column caption='환산신고건수' datatype='real' name='[Calculation_2154535853490214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Incidence_Cases] * [Case_Detection_Rate_pct] / 100' />
            </column>
            <column caption='발견율_전년도' datatype='real' name='[Calculation_2154535853522983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Year] = [Parameters].[매개 변수 2154535845343242] - 1 THEN [Calculation_2154535853490214] END) &#13;&#10;                 / SUM(IF [Year] = [Parameters].[매개 변수 2154535845343242] - 1 THEN [Incidence_Cases] END) * 100' />
            </column>
            <column caption='발견율_증감률' datatype='real' name='[Calculation_2154535853572136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2154535853727786] - [Calculation_2154535853522983]) / ABS([Calculation_2154535853522983])' />
            </column>
            <column caption='발견율_개선여부' datatype='boolean' name='[Calculation_2154535853604905]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2154535853572136] &gt;= 0' />
            </column>
            <column caption='발견율_당해연도' datatype='real' name='[Calculation_2154535853727786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Year] = [Parameters].[매개 변수 2154535845343242] THEN [Calculation_2154535853490214] END) &#13;&#10;                   / SUM(IF [Year] = [Parameters].[매개 변수 2154535845343242] THEN [Incidence_Cases] END) * 100' />
            </column>
            <column caption='발견율_증감률_표시' datatype='string' name='[Calculation_2154535890100275]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2154535853572136] &gt;= 0 &#13;&#10;THEN &quot;▲ &quot; + STR(ROUND([Calculation_2154535853572136]*100, 2)) + &quot;%&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(ROUND(-[Calculation_2154535853572136]*100, 2)) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='범위 필터' datatype='boolean' name='[Calculation_2154535892418612]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2154535832719363]&#13;&#10;WHEN &quot;전세계&quot; THEN TRUE&#13;&#10;WHEN &quot;지역&quot; THEN [Region_Code] = [Parameters].[매개 변수 2154535832850436]&#13;&#10;WHEN &quot;국가&quot; THEN [Country] = [Parameters].[매개 변수 2154535833366534]&#13;&#10;END' />
            </column>
            <column caption='Case Detection Rate pct' datatype='real' name='[Case_Detection_Rate_pct]' role='measure' type='quantitative' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <semantic-values semantic-role='[Country].[Name]'>
                <semantic-value key='&quot;Netherlands Antilles&quot;' value='&quot;퀴라소&quot;' />
                <semantic-value key='&quot;Serbia &amp; Montenegro&quot;' value='&quot;세르비아&quot;' />
              </semantic-values>
