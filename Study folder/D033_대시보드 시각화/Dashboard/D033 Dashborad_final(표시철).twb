              </semantic-values>
              <semantic-values semantic-role='[Geographical].[Longitude]'>
                <semantic-value key='&quot;West Bank and Gaza Strip&quot;' value='20.5' />
              </semantic-values>
            </column>
            <column caption='Incidence Cases' datatype='real' name='[Incidence_Cases]' role='measure' type='quantitative' />
            <column caption='Region Code' datatype='string' name='[Region_Code]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_2154535892418612]' derivation='None' name='[none:Calculation_2154535892418612:nk]' pivot='key' type='nominal' />
