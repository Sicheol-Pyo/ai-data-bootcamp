        <calculation class='tableau' formula='IF [Parameters].[매개 변수 2154535832719363] = &apos;국가&apos; AND [Country] = [Parameters].[매개 변수 2154535833366534] THEN 1&#13;&#10;ELSEIF [Parameters].[매개 변수 2154535832719363] = &apos;지역&apos; AND [Region_Name] = [Parameters].[매개 변수 2154535832850436] THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
