              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2154535827435520]&#13;&#10;WHEN &apos;발생률 (Incidence)&apos; THEN SUM([Incidence_Cases])&#13;&#10;WHEN &apos;유병률 (Prevalence)&apos; THEN SUM([Prevalence_Cases])&#13;&#10;WHEN &apos;사망률-HIV제외 (Mortality)&apos; THEN SUM([Mortality_Cases])&#13;&#10;WHEN &apos;사망률-HIV양성 (Mortality HIV+)&apos; THEN SUM([Mortality_HIV_Cases])&#13;&#10;WHEN &apos;HIV양성 발생률 (Incidence HIV+)&apos; THEN SUM([Incidence_HIV_Cases])&#13;&#10;END' />
            </column>
            <column caption='선택지표_비율(10만명당)' datatype='real' name='[Calculation_2154535828574210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2154535827435520]&#13;&#10;WHEN &apos;발생률 (Incidence)&apos; THEN SUM([Incidence_Cases]) / SUM([Population]) * 100000&#13;&#10;WHEN &apos;유병률 (Prevalence)&apos; THEN SUM([Prevalence_Cases]) / SUM([Population]) * 100000&#13;&#10;WHEN &apos;사망률-HIV제외 (Mortality)&apos; THEN SUM([Mortality_Cases]) / SUM([Population]) * 100000&#13;&#10;WHEN &apos;사망률-HIV양성 (Mortality HIV+)&apos; THEN SUM([Mortality_HIV_Cases]) / SUM([Population]) * 100000&#13;&#10;WHEN &apos;HIV양성 발생률 (Incidence HIV+)&apos; THEN SUM([Incidence_HIV_Cases]) / SUM([Population]) * 100000&#13;&#10;END' />
            </column>
